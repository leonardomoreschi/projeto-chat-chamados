# ============================================
# Configuração Docker - Chat Interno
# ============================================

# Ambiente
APP_ENV=production
APP_SECRET=TROQUE_POR_STRING_ALEATORIA_64_CARACTERES_AQUI

# Banco de Dados (DNS interno do Docker)
DB_HOST=mysql
DB_PORT=3306
DB_HOST_PORT=3307
DB_NAME=chat_db
DB_USER=chat_user
DB_PASS=SenhaForte123!@#
DB_ROOT_PASS=RootSenhaForte456!@#

# Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED=jpg,jpeg,png,gif,pdf,doc,docx,zip

# Web Push (notificações do sistema operacional)
# Gere o par com:
#   docker compose exec php php -r 'require "/var/www/html/vendor/autoload.php"; print_r(Minishlink\WebPush\VAPID::createVapidKeys());'
# Deixar em branco desliga o recurso: o botão "Ativar notificações" some e o
# push-worker encerra sem fazer nada. Trocar as chaves invalida as inscrições
# já existentes (os navegadores se reinscrevem sozinhos no próximo acesso).
# Só funciona em localhost ou HTTPS — ver docs/push-web-producao-tls.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@empresa.com

# Timezone
TZ=America/Sao_Paulo

# Portas expostas no host da VM
WEB_HOST_PORT=8188

# Usuário admin inicial criado automaticamente no primeiro boot
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=password