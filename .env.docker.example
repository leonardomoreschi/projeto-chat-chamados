# ============================================
# Configuração Docker - Chat Interno
# ============================================

# Ambiente
APP_ENV=production
APP_SECRET=TROQUE_POR_STRING_ALEATORIA_64_CARACTERES_AQUI

# Banco de Dados (DNS interno do Docker)
DB_HOST=mysql
DB_PORT=3306
DB_HOST_PORT=3307
DB_NAME=chat_db
DB_USER=chat_user
DB_PASS=SenhaForte123!@#
DB_ROOT_PASS=RootSenhaForte456!@#

# Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED=jpg,jpeg,png,gif,pdf,doc,docx,zip

# Duração da sessão de login, em dias (padrão 7 = entra uma vez por semana)
SESSION_LIFETIME_DIAS=7

# Timezone
TZ=America/Sao_Paulo

# Portas expostas no host da VM
WEB_HOST_PORT=8188
# Porta HTTPS. O bloco TLS do nginx só sobe quando existe certificado em
# docker/nginx/certs (scripts/gerar-certificados.sh) — e é ele que destrava as
# notificações do navegador, que exigem contexto seguro.
WEB_HOST_PORT_HTTPS=8443

# Usuário admin inicial criado automaticamente no primeiro boot
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=password